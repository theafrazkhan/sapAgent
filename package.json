{
  "name": "smart-factory",
  "version": "0.1.0-alpha.2",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "db:inspect": "node --env-file=.env.local --import tsx scripts/database.ts inspect",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/database.ts migrate",
    "db:runtime-role": "node --env-file=.env.local --import tsx scripts/database.ts runtime-role",
    "user:create": "node --env-file=.env.local --import tsx scripts/database.ts user",
    "seed:local": "node --env-file=.env.local --import tsx scripts/database.ts seed",
    "import:local": "node --env-file=.env.local --import tsx scripts/import-local.ts",
    "storage:check": "node --env-file=.env.local --import tsx scripts/storage-check.ts",
    "ai:check": "node --env-file=.env.local --import tsx scripts/ai-check.ts",
    "db-run": "node --env-file=.env.local --import tsx scripts/database.ts",
    "jobs": "node --env-file=.env.local --import tsx scripts/ops.ts",
    "dev:api": ".venv/bin/python scripts/backend-dev.py"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "minio": "^8.0.0",
    "next": "^16.0.0",
    "openai": "^6.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
